# Cấu hình API Key của Google Gemini (lấy tại https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini mặc định (ví dụ: gemini-3.8-flash, gemini-2.5-flash,...)
GEMINI_MODEL=gemini-3.8-flash

# Cổng lắng nghe máy chủ (mặc định 7860 cho Hugging Face Spaces, 10000 cho Render, 8000 khi chạy local)
PORT=8000
